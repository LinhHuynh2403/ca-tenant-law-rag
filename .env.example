# Copy this file to .env and fill in your own values.
# .env is gitignored -- never commit real secrets.

VOYAGE_API_KEY=pa-...
ANTHROPIC_API_KEY=sk-ant-...

# Matches docker-compose.yml (host port 5434 -- 5432 is local Postgres 14,
# 5433 is already used by another project's container).
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/ca_tenant_law
